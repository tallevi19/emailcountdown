# App
NEXTAUTH_SECRET=                          # openssl rand -base64 32
NEXTAUTH_URL=https://emailcountdown.net

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/emailcountdown

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paddle Billing v2
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox      # sandbox | production

# Paddle Price IDs (create in Paddle dashboard)
PADDLE_STARTER_MONTHLY_PRICE_ID=
PADDLE_STARTER_ANNUAL_PRICE_ID=
PADDLE_STANDARD_MONTHLY_PRICE_ID=
PADDLE_STANDARD_ANNUAL_PRICE_ID=
PADDLE_POWER_MONTHLY_PRICE_ID=
PADDLE_POWER_ANNUAL_PRICE_ID=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@emailcountdown.net

# GIF base URL (your Railway app URL or custom domain)
NEXT_PUBLIC_GIF_BASE_URL=https://emailcountdown.net

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@emailcountdown.net
